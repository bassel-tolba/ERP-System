+        verbose_name = _("Supplier Debit Memo")
+        verbose_name_plural = _("Supplier Debit Memos")
+        unique_together = ('supplier', 'memo_number')
+
+    def __str__(self):
+        return f"Debit Memo {self.memo_number} to {self.supplier.name}"




