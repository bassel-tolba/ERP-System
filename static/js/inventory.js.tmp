document.addEventListener('DOMContentLoaded', function() {
    // Get references to select elements
    const productSelect = document.getElementById('product_id');
    const tagSelect = document.getElementById('tags');
    const editProductSelect = document.getElementById('editProductId');
    const editTagSelect = document.getElementById('editTags');
    
    // Function to initialize or reinitialize TomSelect
    function initializeTomSelect(element) {
        if (window.TomSelect && element) {
            const existingInstance = TomSelect.getInstance(element);
            if (existingInstance) {
                existingInstance.destroy();
            }
            return new TomSelect(element, {
                plugins: ['remove_button'],
                placeholder: 'اختر الوسوم المناسبة'
            });
        }
        return null;
    }

    // Function to load product tags
    function loadProductTags(productId, targetSelect) {
        if (!productId || !targetSelect) {
            if (targetSelect) {
                targetSelect.innerHTML = '<option value="">يرجى اختيار منتج أولاً</option>';
                targetSelect.disabled = true;
            }
            return;
        }

        // Enable the tags select
        targetSelect.disabled = false;

        // Fetch tags for the selected product
        fetch(`/inventory/api/product_tags/${productId}/`)
            .then(response => response.json())
            .then(data => {
                // Clear existing options
                targetSelect.innerHTML = '';
                
                // Add new options
                data.tags.forEach(tag => {
                    const option = document.createElement('option');
                    option.value = tag.id;
                    option.textContent = tag.name;
                    targetSelect.appendChild(option);
                });

                // If no tags are available
                if (data.tags.length === 0) {
                    const option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'لا توجد وسوم لهذا المنتج';
                    targetSelect.appendChild(option);
                }

                // Initialize Tom Select
                initializeTomSelect(targetSelect);
            })
            .catch(error => {
                console.error('Error loading product tags:', error);
                targetSelect.innerHTML = '<option value="">خطأ في تحميل الوسوم</option>';
            });
    }

    // Add event listener for product selection in main form
    if (productSelect) {
        productSelect.addEventListener('change', (e) => {
            loadProductTags(e.target.value, tagSelect);
        });
    }

    // Add event listener for product selection in edit form
    if (editProductSelect) {
        editProductSelect.addEventListener('change', (e) => {
            loadProductTags(e.target.value, editTagSelect);
        });
    }

    // Load tags when edit modal opens
    const editModal = document.getElementById('editRecordModal');
    if (editModal) {
        editModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const productId = button.getAttribute('data-product-id');
            if (productId) {
                loadProductTags(productId, editTagSelect);
            }
        });
    }
});
